# Copie para .env (nunca versionado) e preencha. O robô lê este arquivo na pasta onde é executado.

# Telegram — token do BotFather e chat_id do destinatário (aceita também TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID)
TOKEN_TELEGRAM=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAT_ID=123456789

# MetaTrader 5 (Windows; `pip install MetaTrader5`). Login/senha/servidor são opcionais se o terminal já está logado.
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_SYMBOL=XAUUSD

# Gestão de risco (2.2) — a IA não pode alterar estes limites; o lote sai do risco fixo, nunca da confiança
RISK_PER_TRADE=0.5
MAX_DAILY_LOSS=2
MAX_POSITIONS=1
MAX_LOT=0.10
MAX_SPREAD=0.60
MAX_SLIPPAGE=0.30
CONTRACT_SIZE=100

# 3.0 — kill switch e limites adicionais
# TRADING_ENABLED=false bloqueia novas entradas (o robô continua analisando e gerindo o que está aberto)
TRADING_ENABLED=true
# drawdown máximo (%) sobre o pico de capital → TRADING STOP
MAX_DRAWDOWN=10
# alvo precisa ter pelo menos este R até a próxima resistência/suporte forte (H4/D1); senão NÃO OPERAR
MIN_RR_TO_STRUCTURE=2
