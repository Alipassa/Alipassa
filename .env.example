# Copie para .env e preencha com os valores do BotFather / seu chat_id
TOKEN_TELEGRAM=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAT_ID=123456789

# MetaTrader 5 (Windows)
MT5_PATH=C:\Program Files\Pepperstone MetaTrader 5\terminal64.exe
MT5_SYMBOL=XAUUSD

# Gestão de risco (2.2) — a IA não pode alterar estes limites
RISK_PER_TRADE=3
MAX_DAILY_LOSS=6
MAX_POSITIONS=1
MAX_LOT=1.0
MAX_SPREAD=0.60
MAX_SLIPPAGE=0.30
CONTRACT_SIZE=100

# 3.0 — kill switch e limites adicionais
TRADING_ENABLED=true
MAX_DRAWDOWN=10
# META DIÁRIA (%): trava, não obrigação — ao atingir, sem novas entradas até o dia seguinte (0 = desligada)
DAILY_TARGET=10
# ESCADA DE RISCO (5.2): % por operação em função do tier do ciclo de vida de cada mercado — decidida ANTES dos resultados,
# nunca mexida depois de ganhos ou perdas. base (<30 casos OOS) · operacional (≥30) · validado (≥50), só com edge positivo
# e estado NORMAL/REATIVADO; em ALERTA/PROTEÇÃO/SUSPENSO volta à base. Vazio = base × (1, 4/3, 5/3). Teto RISK_LADDER_MAX.
RISK_LADDER=3,4,5
RISK_LADDER_MAX=5
MIN_RR_TO_STRUCTURE=2

# 4.0 — carteira multi-mercado (a IA não altera estes limites)
MAX_TOTAL_OPEN_RISK=6
MAX_CORRELATED_RISK=3
MAX_PORTFOLIO_POSITIONS=3
MAX_ASSET_EXPOSURE=1
CORRELATION_THRESHOLD=0.5
# símbolos do broker quando diferem do padrão (ex.: Pepperstone)
MT5_SYMBOL_XAUUSD=XAUUSD
MT5_SYMBOL_EURUSD=EURUSD
MT5_SYMBOL_US500=US500
MT5_SYMBOL_USDJPY=USDJPY
MT5_SYMBOL_WTI=SpotCrude

# BANCO HISTÓRICO de notícias/eventos (opcional; `history fetch-te` / `history fetch-alfred`)
TE_API_KEY=
FRED_API_KEY=
# fuso do servidor da corretora (auto-detectado pelo último tick; force aqui se necessário, ex.: 3)
MT5_UTC_OFFSET_HOURS=
